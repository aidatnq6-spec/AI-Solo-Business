{
  "name": "so-noi-dung",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/rules/**",
    "test:rules": "vitest run tests/rules",
    "emulators": "node scripts/firebase.mjs emulators:start --project demo-content-studio --only auth,firestore,storage",
    "emulators:test": "node scripts/firebase.mjs emulators:exec --project demo-content-studio --only auth,firestore,storage \"npm run test:rules\"",
    "worker": "tsx services/agent-worker/src/run.ts"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.127",
    "@google-cloud/tasks": "7.3.1",
    "ai": "7.0.154",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eve": "0.84.0",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "google-auth-library": "11.3.1",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase-tools": "15.34.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "eve": {
      "undici": "8.12.3"
    }
  }
}
