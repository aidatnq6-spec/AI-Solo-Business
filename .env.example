# Default is a local-only demo, with persisted server-side files and NO paid AI calls.
APP_MODE=demo
NEXT_PUBLIC_APP_MODE=demo
OWNER_UID=local-owner

# For local Firebase Emulator mode, set BOTH app modes to emulator and run npm run emulators.
# APP_MODE=emulator
# NEXT_PUBLIC_APP_MODE=emulator
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# FIREBASE_PROJECT_ID=demo-content-studio
# FIREBASE_STORAGE_BUCKET=demo-content-studio.appspot.com
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-content-studio
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-content-studio.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-content-studio.appspot.com

# Production: APP_MODE=firebase, NEXT_PUBLIC_APP_MODE=firebase, OWNER_UID=<your uid>.
# Use Application Default Credentials on Google Cloud. Never paste service-account JSON here.
# AI_MODE=gateway
# AI_GATEWAY_API_KEY=<server-side secret>
# TEXT_MODEL=<provider/model verified in current gateway catalog>
# IMAGE_MODEL=<provider/model verified in current gateway catalog>
# DAILY_AI_CALL_LIMIT=20
# CLOUD_TASKS_PROJECT=<project>
# CLOUD_TASKS_LOCATION=<region>
# CLOUD_TASKS_QUEUE=content-studio
# WORKER_URL=https://<private-worker>
# WORKER_SERVICE_ACCOUNT=<service-account-email>
